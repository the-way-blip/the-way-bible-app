{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/bible-page?kind=sitemap-index"
    },
    {
      "source": "/sitemaps/:file",
      "destination": "/api/bible-page?kind=sitemap&file=:file"
    },
    {
      "source": "/bible",
      "destination": "/api/bible-page?kind=bible"
    },
    {
      "source": "/bible/search",
      "destination": "/api/bible-page?kind=search"
    },
    {
      "source": "/bible/:book",
      "destination": "/api/bible-page?kind=book&book=:book"
    },
    {
      "source": "/bible/:book/:chapter",
      "destination": "/api/bible-page?kind=chapter&book=:book&chapter=:chapter"
    },
    {
      "source": "/bible/:book/:chapter/:verse",
      "destination": "/api/bible-page?kind=verse&book=:book&chapter=:chapter&verse=:verse"
    },
    {
      "source": "/verses-about",
      "destination": "/api/bible-page?kind=topics"
    },
    {
      "source": "/verse-of-the-day",
      "destination": "/api/bible-page?kind=votd"
    },
    {
      "source": "/verses-about/:topic",
      "destination": "/api/bible-page?kind=topic&topic=:topic"
    },
    {
      "source": "/word/:id",
      "destination": "/api/app-page?id=:id"
    },
    {
      "source": "/privacy",
      "destination": "/api/app-page?page=privacy"
    },
    {
      "source": "/terms",
      "destination": "/api/app-page?page=terms"
    },
    {
      "source": "/login",
      "destination": "/api/app-page?page=login"
    },
    {
      "source": "/((?!api|data|assets|favicon|manifest|icons|.well-known|bible|verses-about|verse-of-the-day|sitemap).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ],
  "functions": {
    "api/bible-page.js": {
      "includeFiles": "seo/data/*.json"
    },
    "api/app-page.js": {
      "includeFiles": "{dist/index.html,public/data/lexicon.json,public/data/strongs/*.json}"
    }
  }
}
